document.addEventListener("DOMContentLoaded", function() {
    // Inizializza Lenis con la fluidità impostata a 0.05 (come da tuo screenshot)
    const lenis = new Lenis({
        lerp: 0.05,
        smoothWheel: true
    });

    // Sincronizzazione con GSAP e ScrollTrigger (se presenti nella pagina)
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
        lenis.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time) => {
            lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);
    } else {
        // Ciclo Animation Frame standard se GSAP non è presente
        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
    }

    // Gestione Smooth Anchor Links (collegamenti agli ID della pagina #)
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            const targetId = this.getAttribute('href');
            if (targetId && targetId !== '#') {
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    e.preventDefault();
                    lenis.scrollTo(targetElement, {
                        offset: 0 // offset impostato a 0px come da tuo screenshot
                    });
                }
            }
        });
    });
});
